#!/bin/sh
# Block commits that add legal ship-stoppers or secrets / auth-policy breaks.
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

if command -v python >/dev/null 2>&1; then
  PY=python
elif command -v python3 >/dev/null 2>&1; then
  PY=python3
elif command -v py >/dev/null 2>&1; then
  PY="py -3"
else
  echo "watch gates: python not found on PATH" >&2
  exit 1
fi

$PY .cursor/skills/legal-watch/scripts/scan.py --staged --gate || exit $?
exec $PY .cursor/skills/cyber-watch/scripts/scan.py --staged --gate
