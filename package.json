{
  "name": "dag-tails-bartending-game",
  "version": "1.14.1",
  "private": true,
  "description": "DAG Tails — a stage-based bartending simulation game. Zero-build vanilla JS/HTML/CSS on the web, wrapped with Capacitor for iOS/Android testing builds.",
  "scripts": {
    "build": "node scripts/copy-web.js",
    "cap:sync": "npm run build && npx cap sync",
    "android:open": "npm run cap:sync && npx cap open android",
    "ios:open": "npm run cap:sync && npx cap open ios",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:perf": "playwright test tests/performance.spec.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dag-com/last-call-bartending-game.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/dag-com/last-call-bartending-game/issues"
  },
  "homepage": "https://github.com/dag-com/last-call-bartending-game#readme",
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@playwright/test": "^1.54.1",
    "serve": "^14.2.4"
  }
}
