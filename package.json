{
  "name": "dag-tails-bartending-game",
  "version": "1.14.1",
  "private": true,
  "description": "DAG Tails — bartending game. Vite + React hub; vanilla gameplay modules; Capacitor for iOS/Android; Expo WebView shell for remote preview.",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "serve:www": "vite build && npx --yes serve -l 4173 www",
    "cap:sync": "npm run build && npx cap sync",
    "android:open": "npm run cap:sync && npx cap open android",
    "ios:open": "npm run cap:sync && npx cap open ios",
    "expo:start": "npm --prefix mobile start",
    "expo:tunnel": "npm --prefix mobile run tunnel",
    "play:url": "node -e \"console.log('https://dag-com.github.io/last-call-bartending-game/')\"",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:perf": "playwright test tests/performance.spec.js",
    "test:health": "playwright test tests/health.spec.js tests/backend.spec.js --project=pc",
    "test:qa": "node scripts/run-qa.js",
    "test:qa:quick": "playwright test tests/health.spec.js tests/backend.spec.js tests/gameplay.spec.js tests/play-journey.spec.js tests/layout-integrity.spec.js tests/hub-layout.spec.js tests/mixology.spec.js tests/player-fixes.spec.js tests/text-readability.spec.js --project=android --project=ios",
    "test:qa:devices": "node scripts/run-qa.js",
    "healthcheck": "node scripts/healthcheck.js",
    "healthcheck:json": "node scripts/healthcheck.js --json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dag-com/last-call-bartending-game.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/dag-com/last-call-bartending-game/issues"
  },
  "homepage": "https://github.com/dag-com/last-call-bartending-game#readme",
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@supabase/supabase-js": "^2.112.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@playwright/test": "^1.54.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "serve": "^14.2.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
